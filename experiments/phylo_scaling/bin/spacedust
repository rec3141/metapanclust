#!/bin/bash
# Same as tools/bin/spacedust, but niced inside the container (docker children do not inherit the caller's niceness).
exec docker run --rm -i --user $(id -u):$(id -g) -v /data:/data -w "$PWD" metapanclust-runtime:24.04 nice -n 15 /data/scratch/metapanclust_data/tools/spacedust/bin/spacedust "$@"
